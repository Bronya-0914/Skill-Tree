      "prompt": "d[(3x+1)⁴]/dx 是？",
      "options": [
        "4(3x+1)³",
        "12(3x+1)⁴",
        "3(3x+1)³",
        "12(3x+1)³"
      ],
      "answer": 3,
      "explanation": "外層 4(3x+1)³ 再乘內層導數 3。"
    },
    {
      "prompt": "d[sin(2x)]/dx 是？",
      "options": [
        "−2cos(2x)",
        "2sin(2x)",
        "2cos(2x)",
        "cos(2x)"
